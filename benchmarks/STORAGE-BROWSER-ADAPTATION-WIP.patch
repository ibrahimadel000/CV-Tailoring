+      r.onsuccess = () => resolve(r.result); r.onerror = () => reject(r.error);
+    });
+    try {
+      await new Promise((resolve, reject) => {
+        const tx = db.transaction('cv-tailor-canonical-v1', 'readwrite');
+        const store = tx.objectStore('cv-tailor-canonical-v1'), r = store.get('workspace');
+        r.onsuccess = () => {
+          const record = r.result;
+          if (!record || record.format !== 1 || !record.revision || !Array.isArray(record.values) || record.values.length !== 3) { tx.abort(); return; }
+          // Legacy puts cloned each key separately; preserve graphs within each
+          // value without inventing cross-key aliases in fixture setup.
+          if (profiles !== undefined) record.values[0] = structuredClone(profiles);
+          if (activeId !== undefined) record.values[1] = structuredClone(activeId);
+          if (theme !== undefined) record.values[2] = structuredClone(theme);
+          record.revision = crypto.randomUUID();
+          store.put(record, 'workspace');
+        };
+        tx.oncomplete = resolve; tx.onabort = tx.onerror = () => reject(tx.error || new Error('Canonical fixture write failed'));
+      });
+    } finally { db.close(); }
+  }, { profiles, activeId, theme });
