+    const db = await new Promise((resolve, reject) => {
+      const r = indexedDB.open('keyval-store');
+      r.onsuccess = () => resolve(r.result); r.onerror = () => reject(r.error);
+    });
+    try {
+      return await new Promise((resolve, reject) => {
+        const tx = db.transaction('cv-tailor-canonical-v1', 'readonly');
+        const r = tx.objectStore('cv-tailor-canonical-v1').get('workspace');
+        tx.oncomplete = () => {
+          const record = r.result;
+          if (!record || record.format !== 1 || !record.revision || !Array.isArray(record.values) || record.values.length !== 3)
+            return reject(new Error('Missing or invalid canonical workspace record'));
+          resolve({ profiles: record.values[0], activeId: record.values[1] });
+        };
+        tx.onabort = tx.onerror = () => reject(tx.error || new Error('Canonical read failed'));
+      });
+    } finally { db.close(); }
+  });
+}
+async function writeCanonicalFixture(page, { profiles, activeId, theme }) {
