# Environment variables — copy to .env and fill in your values

# Server-side Gemini API key (used by `npm run server`, Cloudflare Pages Functions, and Vercel)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API endpoint for production or local proxy mode (no API key in browser)
VITE_TAILOR_API_URL=/api/tailor

# Optional: protect /api/tailor with a bearer token in staging/private deployments
# TAILOR_ACCESS_TOKEN=

# Optional: DEV-only direct browser key (ignored in production builds)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
