+
+/* Interactive word-level diff & per-bullet revert controls */
+.tailor-diff-review { display: grid; gap: 10px; margin: 10px 0; }
+.diff-card { background: #fff; border: 1px solid #dce5ee; border-radius: 8px; padding: 10px 12px; display: grid; gap: 6px; }
+.diff-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; font-size: 13px; color: #1f2f44; }
+.diff-badge { font-size: 11px; font-weight: 600; background: #e8f1fb; color: #24538d; padding: 2px 7px; border-radius: 999px; }
+.diff-body, .diff-item { font-size: 13px; line-height: 1.55; color: #243044; margin: 0; overflow-wrap: anywhere; }
+.diff-unchanged { font-size: 12.5px; color: #617082; margin: 0; }
+.diff-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
+.diff-item { padding-top: 6px; border-top: 1px solid #eef2f6; display: grid; gap: 4px; }
+.diff-item:first-child { padding-top: 0; border-top: none; }
+.diff-added { background: #dcfce7; color: #14532d; text-decoration: none; border-radius: 3px; padding: 0 2px; }
+.diff-removed { background: #fee2e2; color: #991b1b; text-decoration: line-through; border-radius: 3px; padding: 0 2px; }
+.diff-action { font-size: 12px; padding: 2px 6px; justify-self: start; display: inline-flex; align-items: center; gap: 4px; }
+.diff-chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.diff-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; padding: 4px 8px; border-radius: 999px; border: 1px solid #cbd6e2; background: #f8fafc; color: #243044; cursor: pointer; }
+.diff-chip:hover { background: #edf4fc; border-color: #8fb1d9; color: #1b4375; }
